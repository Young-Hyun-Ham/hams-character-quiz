
# hyh8414@gmail.com xxx
# FIREBASE_PROJECT_ID=xxx
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv/8I=\n-----END PRIVATE KEY-----\n"
# 기본값과 다른 버킷일 때만 설정
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# 이 애플리케이션의 외부 기준 URL
NEXT_PUBLIC_APP_URL=http://localhost:3010

# HAMS SSO 서버
HAMS_OAUTH_SERVER_URL=http://localhost:3000
HAMS_OAUTH_CLIENT_ID=xxx
HAMS_OAUTH_CLIENT_SECRET=xxx

# 서비스마다 별도로 생성한 서버 전용 난수
HAMS_COOKIE_PREFIX=xxx
HAMS_SESSION_SECRET=xxx

# 선택 사항. 유효한 양의 정수가 아니면 기본값 604800(7일)을 사용한다.
HAMS_SSO_SESSION_MAX_AGE_SEC=604800

# 임시 로그인 mock data 사용 허용
NEXT_PUBLIC_DEV_MOCK_LOGIN=false
HAMS_SSO_DEV_MOCK_USER_ID=
HAMS_SSO_DEV_MOCK_USER_EMAIL=
HAMS_SSO_DEV_MOCK_USER_LOGIN_ID=
HAMS_SSO_DEV_MOCK_USER_NAME=
